# ==============================================================================
# Void Vibe — ENVIRONMENT CONFIGURATION
# Tagline: 🎧 Your soundtrack, your server.
# Description: Play music, manage queues, and enjoy your favorite tracks with Void Vibe.
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your .env file or share your bot token with anyone.

# Discord Bot Token (Required)
# Obtain this from the Discord Developer Portal: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Lavalink Server Configuration
# The URI should include protocol and port (e.g. http://127.0.0.1:2333)
LAVALINK_URI=http://127.0.0.1:2333
LAVALINK_PASSWORD=change_this_password

# Inactivity Timeout (in seconds)
# Disconnects the bot and cleans up the player when idle and queue is empty (Default: 300 = 5 minutes)
INACTIVITY_TIMEOUT=300

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL (Default: INFO)
LOG_LEVEL=INFO

# Optional: Default Volume (0 - 100) (Default: 100)
DEFAULT_VOLUME=100

# Optional: Discord Guild ID for instant slash command registration during development
# If set, slash commands sync instantly to this guild instead of taking up to an hour globally.
# GUILD_ID=123456789012345678

# Optional: Spotify API Credentials (LavaSrc plugin metadata resolution)
# SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Optional: Apple Music Developer Token (Required only if plugins.lavasrc.sources.applemusic is true in application.yml)
# APPLE_MUSIC_MEDIA_API_TOKEN=your_apple_music_media_api_token_here

# Optional: YouTube OAuth Refresh Token (Keeps playback authenticated without committing to Git)
# YOUTUBE_OAUTH_REFRESH_TOKEN=your_oauth_refresh_token_here

