# ==============================================================================
# VOIDKAGE MUSIC — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your .env file or share your bot token with anyone.

# Discord Bot Token (Required)
# Obtain this from the Discord Developer Portal: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Lavalink Server Configuration
# The URI should include protocol and port (e.g. http://127.0.0.1:2333)
LAVALINK_URI=http://127.0.0.1:2333
LAVALINK_PASSWORD=youshallnotpass

# Inactivity Timeout (in seconds)
# Disconnects the bot and cleans up the player when idle and queue is empty (Default: 300 = 5 minutes)
INACTIVITY_TIMEOUT=300

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL (Default: INFO)
LOG_LEVEL=INFO

# Optional: Default Volume (0 - 100) (Default: 100)
DEFAULT_VOLUME=100

# Optional: Discord Guild ID for instant slash command registration during development
# If set, slash commands sync instantly to this guild instead of taking up to an hour globally.
# GUILD_ID=123456789012345678
